# Auto detect text files and perform LF normalization
* text=auto

# PHP files
*.php text eol=lf

# Documentation
*.md text eol=lf

# Shell scripts
*.sh text eol=lf

# Config files
.htaccess text eol=lf
Procfile text eol=lf

# JSON files
*.json text eol=lf

# Archives
*.zip binary
*.tar binary
*.gz binary

# Images (if any)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Fonts (if any)
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
